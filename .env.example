# Supabase project URL, for example: https://your-project-ref.supabase.co
SUPABASE_URL=

# Supabase anon/public API key used for Auth calls.
SUPABASE_KEY=

# Server-only Supabase service role key. Never expose this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string used by mem0 long-term memory.
SUPABASE_DB_URL=

# Groq API key used by langchain-groq.
GROQ_API_KEY=

# UUID for server-side task/RAG storage fallback contexts.
# Authenticated API routes replace this with the authenticated user's Supabase user id.
TASK_USER_ID=

# Comma-separated browser origins allowed to call the API.
# Use your deployed frontend/API URL in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Optional model overrides.
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MEM0_LLM_MODEL=llama-3.3-70b-versatile
MEM0_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MEM0_HISTORY_DB_PATH=data/mem0-history.db
